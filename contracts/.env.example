# ---- Arc
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io

# ---- Deployer (needs a little USDC on Arc for gas only)
DEPLOYER_PRIVATE_KEY=0x...

# ---- Roles
OWNER=0x...                      # multisig recommended; defaults to deployer
KEEPER_ADDRESS=0x...             # address of the keeper's KEEPER_PRIVATE_KEY
PROTOCOL_FEE_RECIPIENT=0x...     # defaults to OWNER
PROTOCOL_SHARE_BPS=1000

# ---- Launch access
LAUNCH_OPEN=true                 # anyone can create coins; false = only OWNER + setLauncher addresses

# ---- Pilot limits
START_TICK=-398400               # launch price ≈ $5k market cap (no USDC needed)
MARGIN_CAP_PER_COIN=500000000    # 500 USDC lifetime margin per coin (raise with setMarginCapPerCoin)

# ---- Margin destination (from `python -m levered_keeper setup`)
LIGHTER_CCTP_DOMAIN=6            # Base, until Lighter accepts deposits from Arc (26)
LIGHTER_INTENT_ADDRESS=0x...


# ---- Launch a coin (script/LaunchCoin.s.sol, COIN=LVRD or COIN=TEST)
LEVERED_FACTORY=0x...
