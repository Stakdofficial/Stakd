# Keeper on Robinhood Chain (LEVERED_ENV_FILE=.env.robinhood)
ROBINHOOD_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/YOUR_KEY
# LEVERED_FACTORY=                      # filled in after deploy
KEEPER_PRIVATE_KEY=0x...
LIGHTER_URL=https://api.rh.lighter.xyz
# LIGHTER_MASTER_ACCOUNT_INDEX= / LIGHTER_MASTER_API_PRIVATE_KEY=   # from register-api-key after the first Lighter deposit
LIGHTER_MASTER_API_KEY_INDEX=3
REBALANCE_BAND=0.10
MIN_ORDER_USD=10
MAX_SLIPPAGE=0.005
SWAP_SLIPPAGE=0.02
TAKE_PROFIT_TRIGGER=0.10
TAKE_PROFIT_FRACTION=0.50
BUYBACK_SHARE=0.75
MIN_BUYBACK_USD=5
MIN_MARGIN_ETH=0.005
MIN_FEE_ETH=0.0005
MIN_CLAIM_ETH=0.001
LEVERAGE_HEADROOM=2
MAX_DRAWDOWN=0.35
MIN_GAS_ETH=0.001
ALERT_WEBHOOK_URL=
TICK_SECONDS=60
STATE_PATH=keeper-state.robinhood.json
DRY_RUN=true
